<?xml version="1.0" encoding="UTF-8"?>
<launch4jConfig>
  <!-- Basic Configuration -->
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>lib\shop-management.jar</jar>
  <outfile>ShopManagement.exe</outfile>
  <errTitle>Shop Management System - Error</errTitle>
  <cmdLine></cmdLine>
  <chdir>.</chdir>
  <priority>normal</priority>
  <downloadUrl>https://adoptium.net/</downloadUrl>
  <supportUrl>https://shopmanager.pro/support</supportUrl>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <manifest></manifest>
  <icon>resources\icons\shop_icon.ico</icon>

  <!-- Class Path -->
  <classPath>
    <mainClass>shop.Shop</mainClass>
    <cp>.</cp>
  </classPath>

  <!-- JRE Configuration -->
  <jre>
    <path>runtime</path>
    <bundledJre64Bit>true</bundledJre64Bit>
    <bundledJreAsFallback>true</bundledJreAsFallback>
    <minVersion>1.8.0</minVersion>
    <jdkPreference>preferJre</jdkPreference>
    <runtimeBits>64/32</runtimeBits>
    <initialHeapSize>512</initialHeapSize>
    <maxHeapSize>2048</maxHeapSize>
    <opt>-Dfile.encoding=UTF-8</opt>
  </jre>

  <!-- Version Information -->
  <versionInfo>
    <fileVersion>2.0.0.0</fileVersion>
    <txtFileVersion>2.0 Enterprise</txtFileVersion>
    <fileDescription>Shop Management System - Enterprise Edition</fileDescription>
    <copyright>Copyright © 2026 Shop Manager Pro</copyright>
    <productVersion>2.0.0.0</productVersion>
    <txtProductVersion>2.0 Enterprise</txtProductVersion>
    <productName>Shop Management System</productName>
    <companyName>Shop Manager Pro</companyName>
    <internalName>ShopManagement</internalName>
    <originalFilename>ShopManagement.exe</originalFilename>
    <trademarks></trademarks>
    <language>ENGLISH_US</language>
  </versionInfo>

  <!-- Messages -->
  <messages>
    <startupErr>An error occurred while starting Shop Management System.</startupErr>
    <bundledJreErr>This application requires Java Runtime Environment (JRE) to run. The bundled JRE could not be found.</bundledJreErr>
    <jreVersionErr>This application requires Java 8 or higher to run.</jreVersionErr>
    <launcherErr>The registry refers to a nonexistent Java Runtime Environment installation or the runtime is corrupted.</launcherErr>
    <instanceAlreadyExistsMsg>An instance of Shop Management System is already running.</instanceAlreadyExistsMsg>
  </messages>
</launch4jConfig>
